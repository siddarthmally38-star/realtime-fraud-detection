# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=txn.raw
KAFKA_TOPIC_SCORED=txn.scored
KAFKA_TOPIC_FRAUD_ALERTS=txn.fraud_alerts
KAFKA_TOPIC_DLQ=txn.dlq

# Spark
SPARK_MASTER=spark://spark-master:7077
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints

# Cassandra
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraud_detection
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra

# Redshift
REDSHIFT_HOST=your-cluster.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=fraud_analytics
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=your_password
REDSHIFT_SCHEMA=public

# Fraud Rules
FRAUD_SCORE_THRESHOLD=0.7
HIGH_AMOUNT_THRESHOLD=5000
VELOCITY_WINDOW_MINUTES=10
VELOCITY_MAX_COUNT=5
CARD_TEST_AMOUNT_THRESHOLD=5.0
CARD_TEST_WINDOW_MINUTES=5
CARD_TEST_MIN_COUNT=3

# Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
